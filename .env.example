# Runtime mode: "demo" uses local in-memory data; "database" requires PostgreSQL and auth below.
APP_DATA_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database mode
DATABASE_URL=postgresql://ecopanel:change-me@localhost:5432/ecopanel?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
CONSENT_VERSION=2026-10-26

# Private CV storage. Keep outside public/ and back up with the database.
CV_STORAGE_DIR=var/cv-storage
# CV scanner: clamav, http, or disabled. Leave unset with no scanner settings to store uploads as UNSCANNED.
# ClamAV is fail-closed: unavailable, timed-out, malformed, or failed scans are never downloadable.
CV_SCANNER_PROVIDER=clamav
CV_CLAMAV_HOST=127.0.0.1
CV_CLAMAV_PORT=3310
CV_SCANNER_TIMEOUT_MS=15000
# HTTP scanner receives the raw bytes and must return {"status":"clean"} or {"status":"infected"}.
CV_SCANNER_URL=
CV_SCANNER_TOKEN=
# Development only. Never enable in production. This only permits UNSCANNED files, never INFECTED/SCAN_FAILED.
CV_ALLOW_UNSCANNED_DOWNLOADS=false
# Development only escape hatch for the demo interview surface.
ALLOW_UNAUTHENTICATED_DEMO_INTERVIEWS=false

# Durable CV scan worker. Run with: npm run cv:worker
CV_WORKER_POLL_MS=1000
CV_WORKER_HEALTH_PORT=
CV_WORKER_MAX_JOBS=0

# Transactional email. Credentials belong here (server only), never in PostgreSQL or the client.
# Provider: resend or disabled. Mode: disabled, test, or live.
# Test mode redirects every message to EMAIL_TEST_RECIPIENT. Live mode requires a verified sender domain at the provider.
EMAIL_PROVIDER=disabled
EMAIL_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=Talent Team <talent@example.com>
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=
# Resend webhook signing secret (whsec_...). Verify webhooks from the raw request body.
EMAIL_WEBHOOK_SECRET=
EMAIL_MAX_ATTEMPTS=5
EMAIL_SEND_TIMEOUT_MS=15000
EMAIL_WORKER_LEASE_MS=120000
EMAIL_INTERVIEW_REMINDER_HOURS=24
# Durable email worker. Run with: npm run email:worker
EMAIL_WORKER_POLL_MS=1000
EMAIL_WORKER_HEALTH_PORT=
EMAIL_WORKER_MAX_JOBS=0
EMAIL_WORKER_RECOVERY_INTERVAL_MS=30000
RATE_LIMIT_CLEANUP_INTERVAL_MS=300000

# Google Calendar synchronization. Server-only credentials; never expose tokens to the browser.
# Provider: google or disabled. OAuth scope: openid email https://www.googleapis.com/auth/calendar.events.
CALENDAR_PROVIDER=disabled
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/hr/calendar/google/callback
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the old key in CALENDAR_TOKEN_ENCRYPTION_KEY_PREVIOUS only while rotating encrypted tokens.
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_TOKEN_ENCRYPTION_KEY_PREVIOUS=
CALENDAR_SYNC_TIMEOUT_MS=15000
CALENDAR_SYNC_MAX_ATTEMPTS=5
CALENDAR_SYNC_LEASE_MS=120000
# Durable calendar outbox worker. Run with: npm run calendar:worker
CALENDAR_WORKER_POLL_MS=2000
CALENDAR_WORKER_HEALTH_PORT=
CALENDAR_WORKER_MAX_JOBS=0

# Shared PostgreSQL rate limiting. Fails closed (503) if storage is unavailable.
RATE_LIMIT_SECRET=
RATE_LIMIT_RETENTION_HOURS=1
# Only enable behind a proxy that overwrites X-Forwarded-For/X-Real-IP.
TRUSTED_PROXY_HEADERS=false
RATE_LIMIT_AUTH_SIGNIN_MAX=10
RATE_LIMIT_AUTH_RESET_MAX=5
RATE_LIMIT_AUTH_OTHER_MAX=30
RATE_LIMIT_PUBLIC_APPLY_MAX=8
RATE_LIMIT_APPLICATION_STATUS_MAX=30
RATE_LIMIT_CV_DOWNLOAD_MAX=60
RATE_LIMIT_HR_READ_MAX=120
RATE_LIMIT_HR_MUTATION_MAX=60
RATE_LIMIT_EMAIL_SEND_MAX=30
RATE_LIMIT_EMAIL_WEBHOOK_MAX=600
RATE_LIMIT_INTERVIEW_SESSION_MAX=60
RATE_LIMIT_INTERVIEW_TOKEN_MAX=20
RATE_LIMIT_INTERVIEW_START_MAX=10
RATE_LIMIT_INTERVIEW_STOP_MAX=20
RATE_LIMIT_INTERVIEW_MUTATION_MAX=60

# One-time admin bootstrap (do not keep the password in a committed file).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace Owner
BOOTSTRAP_ORG_NAME=Nexora Labs
BOOTSTRAP_ORG_SLUG=nexora-labs

# Agora / ConvoAI
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_PIPELINE_ID=
AGORA_AGENT_TOKEN=
AGORA_CHANNEL_PREFIX=echopanel
AGORA_AREA=US
LLM_API_KEY=

# Browser E2E (copy to ignored .env.e2e.local). Use a dedicated database whose name ends in _e2e.
E2E_BASE_URL=http://127.0.0.1:3201
E2E_DATABASE_URL=postgresql://ecopanel:change-me@127.0.0.1:55432/ecopanel_e2e?schema=public
# Optional admin connection used to create the _e2e database. Defaults to the same server's /postgres database.
E2E_DB_ADMIN_URL=
E2E_CV_STORAGE_DIR=var/cv-storage-e2e
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_OWNER_NAME=Workspace Owner
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
E2E_OTHER_NAME=Other Workspace Owner
# Playwright starts a deterministic local test scanner; this is not ClamAV and is not production evidence.
CV_SCANNER_PROVIDER=http
CV_SCANNER_URL=http://127.0.0.1:3311/scan
CV_SCANNER_TIMEOUT_MS=5000
# Keep shared limits out of the way for deterministic Playwright runs.
RATE_LIMIT_PUBLIC_APPLY_MAX=100
RATE_LIMIT_AUTH_SIGNIN_MAX=100

# Simulated integrations (not connected in Phase 2A)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NAUKRI_CLIENT_ID=
NAUKRI_CLIENT_SECRET=
JOBHAI_CLIENT_ID=
JOBHAI_CLIENT_SECRET=
